# ─── Supabase Authentication ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── LLM + Embeddings + Reranking (Cohere) — ACTIVE ──────────
COHERE_API_KEY=...
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_EMBED_DIM=1024
COHERE_RERANK_MODEL=rerank-english-v3.0

# ─── OpenAI — RESERVED (not currently active) ────────────────
OPENAI_API_KEY=sk-...
OPENAI_LLM_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIM=3072

# ─── Vector store (Pinecone) ─────────────────────────────────
PINECONE_API_KEY=...
PINECONE_INDEX=rag-pipeline-cohere
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ─── Knowledge graph (Neo4j) ─────────────────────────────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me

# ─── Observability (LangSmith) ───────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=...
LANGCHAIN_PROJECT=neuro-adaptive-graphrag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── App ─────────────────────────────────────────────────────
API_KEY=
ADMIN_PASSWORD=your_admin_password_here
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,*
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVE_TOP_K=20
RERANK_TOP_N=6
